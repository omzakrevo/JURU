# --- Supabase auto-hébergé (VPS) ---------------------------------------------------
# URL publique de l'API Kong de votre instance (ex. https://api.votre-domaine.com)
NEXT_PUBLIC_SUPABASE_URL=
# Clé "anon" (publique, protégée par RLS). Ne mettez JAMAIS la service_role ici.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL publique du site (liens, métadonnées)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Affiche la bannière MODE DÉMONSTRATION (laisser true tant que les paiements réels sont désactivés)
NEXT_PUBLIC_DEMO_MODE=true

# --- Serveur uniquement (jamais exposé au navigateur) ---------------------------------
# Utilisé uniquement par les routes serveur (génération PDF, webhooks) : NE PAS préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Intégrations (serveur uniquement, jamais NEXT_PUBLIC_) — NOMS PROVISOIRES, à confirmer d'après la doc officielle ---
# SMS Bus (Edge Functions : send-sms-hook, notify)
# SMSBUS_API_KEY=
# SMSBUS_SENDER_ID=JURU
# SAS Pay (paiements Orange Money / Moov Money) — inactif tant que payments_live_enabled = false
# SASPAY_BASE_URL=
# SASPAY_API_KEY=
# WEBHOOK_SECRET_SAS_PAY=
