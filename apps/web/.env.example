# --- Supabase auto-hébergé (VPS) ---------------------------------------------------
# URL publique de l'API Kong de votre instance (ex. https://api.votre-domaine.com)
NEXT_PUBLIC_SUPABASE_URL=
# Clé "anon" (publique, protégée par RLS). Ne mettez JAMAIS la service_role ici.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL publique du site (liens, métadonnées)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Affiche la bannière MODE DÉMONSTRATION (laisser true tant que les paiements réels sont désactivés)
NEXT_PUBLIC_DEMO_MODE=true

# --- Serveur uniquement (jamais exposé au navigateur) ---------------------------------
# Utilisé uniquement par les routes serveur (génération PDF, webhooks) : NE PAS préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Intégrations (serveur uniquement, jamais NEXT_PUBLIC_) ---------------------------------------
# SMS Bus — lesmsbus.com (Edge Functions send-sms-hook et notify : à définir dans l'environnement du service functions)
# SMSBUS_ID=                 # identifiant d'API fourni par SMS Bus : SECRET. Ne pas committer.
# SMSBUS_SENDER_ID=JURU      # expéditeur alphanumérique, 12 caractères max
# SMSBUS_URL=https://www.lesmsbus.com:7170/ines.smsbus/smsbusMt
# SMSBUS_SUCCESS_REGEX=      # optionnel : motif du corps de réponse en cas de succès, si SMS Bus le précise
# SAS Pay — docs.saspay.me (inactif tant que payments_live_enabled = false)
# SASPAY_API_KEY=sk_test_…   # sk_live_… refusée par le code tant que les paiements réels ne sont pas activés
# SASPAY_BASE_URL=https://api.saspay.me/api/v1
# WEBHOOK_SECRET_SAS_PAY=    # signing_secret du webhook (affiché UNE seule fois dans le tableau de bord SAS Pay)

# --- Circuit de paiement en MODE TEST SAS Pay (serveur) ---
# NEXT_PUBLIC_PAYMENT_MODE=sandbox      # affichage de la bannière « Mode test SAS Pay » (ne change aucune règle : le mode vient de la base)
# PAYMENTS_WORKER_TOKEN=                # jeton ≥ 24 caractères aléatoires pour la route cron /api/payments/worker
# SASPAY_FALLBACK_EMAIL=                # e-mail technique envoyé à SAS Pay si l'utilisateur n'a pas d'e-mail (champ obligatoire côté SAS Pay)
# SUPABASE_SERVICE_ROLE_KEY=            # déjà listée plus haut : indispensable au worker, SERVEUR UNIQUEMENT
